{
  "name": "agent-primitives",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "check:package": "pnpm -r --if-present run check:package",
    "check:release": "node scripts/guard-release-workflow.mjs",
    "example": "pnpm run --sequential \"/^example:.+$/\"",
    "example:context-guard": "node examples/context-guard/basic.ts",
    "example:agent-state": "node examples/agent-state/basic.ts",
    "example:agent-progress": "node examples/agent-progress/basic.ts",
    "example:agent-retry-guard": "node examples/agent-retry-guard/basic.ts",
    "example:agent-evidence": "node examples/agent-evidence/basic.ts",
    "example:agent-handoff": "node examples/agent-handoff/basic.ts",
    "example:agent-budget": "node examples/agent-budget/basic.ts",
    "example:agent-tool-policy": "node examples/agent-tool-policy/basic.ts",
    "test:release-guard": "node scripts/test-release-guard.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.9.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
