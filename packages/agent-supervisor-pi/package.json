{
  "name": "@j1nn0/agent-supervisor-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "j1nn0",
  "description": "Private contract modules for an autonomous agent supervisor.",
  "types": "./dist/extension.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@j1nn0/agent-retry-guard": "workspace:^"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./dist/extension.js"]
  }
}
