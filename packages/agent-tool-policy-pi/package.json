{
  "name": "@j1nn0/agent-tool-policy-pi",
  "version": "0.1.1",
  "description": "Minimal Pi adapter that enforces caller-declared tool policy through @j1nn0/agent-tool-policy at the tool_call boundary.",
  "license": "MIT",
  "author": "j1nn0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/extension.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j1nn0/agent-primitives.git",
    "directory": "packages/agent-tool-policy-pi"
  },
  "homepage": "https://github.com/j1nn0/agent-primitives/tree/main/packages/agent-tool-policy-pi#readme",
  "bugs": {
    "url": "https://github.com/j1nn0/agent-primitives/issues"
  },
  "keywords": ["pi-package", "ai", "agent", "tool-policy", "reliability"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@j1nn0/agent-tool-policy": "workspace:^"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./dist/extension.js"]
  }
}
